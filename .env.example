# Vorlage für die lokalen Prüfskripte (npm run mail:test, npm run notion:test).
#
#   cp .env.example .env    und dann die Werte eintragen
#
# .env ist von git ausgeschlossen. Dieselben Werte gehören in Vercel unter
# Settings → Environment Variables — dort für Production UND Preview.

# --- Mailversand (Migadu) -------------------------------------------------
SMTP_HOST=smtp.migadu.com
SMTP_PORT=465
SMTP_USER=contact@narratec.io
SMTP_PASS=
SMTP_FROM=contact@narratec.io
SMTP_BCC=contact@narratec.io

# --- Notion ---------------------------------------------------------------
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Herkunftsprüfung -----------------------------------------------------
# Leer lassen, solange gegen Preview-Adressen getestet wird. In Production:
# https://www.narratec.io,https://narratec.io
ALLOWED_ORIGINS=
